{
  "name": "slide-creator",
  "version": "0.1.0",
  "description": "Marp-based corporate slide generator with parameterized design",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "slide-creator": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "marp",
    "slide",
    "presentation",
    "corporate"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^15.0.0",
    "ejs": "^7.0.2",
    "js-yaml": "^5.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@marp-team/marp-cli": "^4.3.1",
    "@types/ejs": "^3.1.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "prettier": "^3.5.1",
    "tsup": "^9.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^5.0.5"
  }
}
